<?xml version="1.0" encoding="utf-8"?>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:padding="10dp"
    android:orientation="vertical"
    android:background="@drawable/background_filter_popup">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseSight"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_close"
            android:contentDescription="Exit Button"
            app:tint="@color/exit_button"
            android:clickable="true"
            android:focusable="true"/>



    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:text="Add Sighting"
        android:textStyle="bold"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_margin="5dp">


        <TextView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:text="Date Sighted:"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/inputMonth"
            android:layout_width="60dp"
            android:layout_height="25dp"
            android:hint="Month"
            android:layout_gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            style="@style/input_field_popup"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="/"
            android:textStyle="bold"
            android:textSize="20sp"
            android:padding="4dp"
            />

        <EditText
            android:id="@+id/inputDay"
            android:layout_width="60dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:hint="Day"
            android:importantForAutofill="no"
            android:inputType="number"
            style="@style/input_field_popup"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="/"
            android:textStyle="bold"
            android:textSize="20sp"
            android:padding="4dp"
            />

        <EditText
            android:id="@+id/inputYear"
            android:layout_width="60dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:hint="Year"
            android:importantForAutofill="no"
            android:inputType="number"
            style="@style/input_field_popup"/>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_margin="5dp">


        <TextView
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:text="Sight Location: "
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/inputLatitude"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:paddingStart="23dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="3dp"
            android:layout_gravity="center"
            android:hint="Latitude"
            android:importantForAutofill="no"
            android:inputType="number"
            style="@style/input_field_popup"/>

        <EditText
            android:id="@+id/inputLongitude"
            android:layout_width="80dp"
            android:layout_height="25dp"
            android:layout_gravity="center"
            android:layout_marginEnd="3dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:hint="Longitude"
            android:importantForAutofill="no"
            android:inputType="number"
            style="@style/input_field_popup"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGetLocation"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:padding="0dp"
            android:backgroundTint="@color/background_filter_btn"
            android:text="Get Location"
            android:textSize="10sp" />


    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApply"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="Add Sighting"
        android:textSize="20sp"
        android:backgroundTint="@color/background_filter_btn" />




</LinearLayout>