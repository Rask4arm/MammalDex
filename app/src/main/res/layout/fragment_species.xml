<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:strokeColor="#000000"
                app:strokeWidth="4dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/mammalImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Image of Mammal"
                    android:scaleType="centerCrop"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/mammalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mammal Name"
                android:textSize="40sp"/>
            <TextView
                android:id="@+id/mammalSciName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scientific Name"
                android:textSize="25sp"
                android:textStyle="italic"/>

            <LinearLayout
                android:id="@+id/otherNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/knownAsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Also Known As:"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/mammalOtherNames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Name, Name, Name)"
                    android:textSize="16sp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wikipedia:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                />
            <TextView
                android:id="@+id/mammalWikiLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link-----------------------------"
                android:textSize="16sp"
                android:textColor="@color/primary_green"
                android:clickable="true"
                android:focusable="true"
                android:textColorHighlight="#400066CC"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Sightings:"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/editSighting"
                        android:layout_width="100dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="7dp"
                        android:layout_gravity="center_vertical"
                        android:text="Edit Sighting"
                        android:textSize="8sp" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sightedList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior">
                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom|end">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/quickAddButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:src="@drawable/icon_plus"
            android:scaleType= "centerInside"
            app:contentPadding="20dp"
            android:tint="@color/white"
            android:background="@color/black"
            app:shapeAppearanceOverlay="@style/CircularImageView"/>

        <Button
            android:id="@+id/addSightingButton"
            android:layout_width="200dp"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:text="Add Sighting"
            android:textSize="20sp"/>

    </LinearLayout>







</LinearLayout>
