<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.example.mammaldex.view.ProfileFragment">

    <!-- Content for Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/header_profile"
        android:textAlignment="center"
        android:textSize="30sp"
        android:textColor="@color/black"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Display Username Programmatically"
        android:textAlignment="center"
        android:textSize="32sp"
        android:textColor="@color/black"
        android:textStyle="italic"/>

    <!-- Content for About Us Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top|center"
        android:weightSum="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutUsBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:text="@string/btn_about_us"
            android:textStyle="bold"
            android:textSize="26sp"/>

    </LinearLayout>

    <!-- Content for Acknowledgements Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top|center"
        android:weightSum="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ackBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:text="@string/btn_acknowledgements"
            android:textStyle="bold"
            android:textSize="26sp"/>

    </LinearLayout>

    <!-- Content for Data Sync Date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="1">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="Last Synced"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/dateSynced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="Last Synced"
            android:textAlignment="center"/>

    </LinearLayout>

    <!-- Content for Resync Data Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top|center"
        android:weightSum="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resyncBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:text="@string/btn_resync"
            android:textStyle="bold"
            android:textSize="26sp"/>

    </LinearLayout>

    <!-- Content for Resync Data Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top|center"
        android:weightSum="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.75"
            android:text="@string/btn_logout"
            android:textStyle="bold"
            android:textSize="26sp"/>

    </LinearLayout>

</LinearLayout>
