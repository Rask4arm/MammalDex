<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mammalCard"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:strokeColor="#000000"
        app:strokeWidth="4dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop">

        <ImageView
            android:id="@+id/mammalImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF0000"/>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/mammalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mammal Name"
        android:textSize="40sp"/>
    <TextView
        android:id="@+id/mammalSciName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scientfic Name"
        android:textSize="25sp"
        android:textStyle="italic"/>

    <LinearLayout
        android:id="@+id/otherNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also Known As:"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/mammalOtherNames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Name, Name, Name)"
            android:textSize="16sp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wikipedia:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        />
    <TextView
        android:id="@+id/mammalWikiLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Link-----------------------------"
        android:textSize="16sp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description:"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom|end">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/quickAddButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:src="@drawable/icon_plus"
            android:scaleType= "centerInside"
            app:contentPadding="20dp"
            android:tint="@color/white"
            android:background="@color/black"
            app:shapeAppearanceOverlay="@style/CircularImageView"/>

        <Button
            android:id="@+id/addSightingButton"
            android:layout_width="200dp"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:text="Add Sighting"
            android:textSize="20dp"/>

    </LinearLayout>







</LinearLayout>
